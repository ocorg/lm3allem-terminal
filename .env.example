# ── DATABASE (Neon) ───────────────────────────────────
# Pooled connection for app queries
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/lm3allem?sslmode=require&pgbouncer=true"
# Direct connection for Prisma migrations + seed + scripts
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/lm3allem?sslmode=require"

# ── AUTH ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32   (also signs the manager-override tokens)
AUTH_SECRET="your-32-char-secret-here"
AUTH_URL="http://localhost:3000"

# ── PASSWORD SECURITY ─────────────────────────────────
# Mixed into every password hash (HMAC) before bcrypt. Set once, NEVER change it afterwards
# (changing it invalidates every existing password). Falls back to the legacy PIN_HASH_PEPPER.
AUTH_PASSWORD_PEPPER="your-random-pepper-string"

# ── FIRST ACCOUNTS (only read by `npm run db:seed`; there is no default login) ──
# SEED_ADMIN_NAME="Owner"
# SEED_ADMIN_EMAIL="owner@example.com"
# SEED_ADMIN_PASSWORD="a-long-initial-password"      # the admin must change it at first login
# Invisible full-permission maintenance account (can also be created with scripts/create-ghost.ts)
# SEED_GHOST_EMAIL="ghost@example.com"
# SEED_GHOST_PASSWORD="a-long-random-password"

# ── CLOUDFLARE R2 ────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID="your-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-secret-access-key"
# Public bucket: product photos only
CLOUDFLARE_R2_BUCKET_NAME="lm3allem-assets"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
# PRIVATE bucket (NO public access): rental guarantee documents (ID card, passport, licence).
# They are only served through the authenticated /api/files route.
CLOUDFLARE_R2_PRIVATE_BUCKET_NAME="lm3allem-private"

# ── PUSHER ───────────────────────────────────────────
PUSHER_APP_ID="your-app-id"
PUSHER_KEY="your-key"
PUSHER_SECRET="your-secret"
PUSHER_CLUSTER="eu"
NEXT_PUBLIC_PUSHER_KEY="your-key"
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# ── TELEGRAM ALERTS (replaces e-mail) ────────────────
# 1) In Telegram, talk to @BotFather, send /newbot, copy the token it gives you.
# 2) Send any message to your new bot (or add it to a group), then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy  "chat":{"id": ...}  (groups start with -)
# Without these two lines nothing is sent to Telegram; the in-app bell keeps working.
TELEGRAM_BOT_TOKEN="123456:ABC-your-bot-token"
TELEGRAM_CHAT_ID="123456789"

# ── CRON ─────────────────────────────────────────────
# Protects GET /api/cron/overdue (daily overdue-rental alerts):
#   curl -H "Authorization: Bearer $CRON_SECRET" https://<host>/api/cron/overdue
CRON_SECRET="your-cron-secret"
