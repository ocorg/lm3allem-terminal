generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"

}

// ─── ENUMS ────────────────────────────────────────────

/// ghost = invisible full-permission maintenance/verification account.
/// It is never listed, never logged, never counted, and cannot be created from the UI.
enum Role {
  admin
  staff
  ghost
}

enum Theme {
  dark
  light
}

enum Language {
  fr
  ar
}

enum Portal {
  magazin
  costumes
  lm3allem
}

enum PaymentMethod {
  cash
  tpe
  banque
  credit
}

enum GuaranteeType {
  cash_deposit
  id_card
  passport
  drivers_license
}

enum RentalStatus {
  booked
  in_preparation
  ready_for_pickup
  picked_up
  returned
  cleaning
  available
  cancelled
}

enum ItemSegment {
  sale
  rental
}

enum TransactionType {
  sale
  rental_payment
  deposit_collected
  deposit_returned
  remaining_balance
  manual_entry
  credit_payment
  /// money handed back to the customer when a rental is cancelled
  rental_refund
}

enum CreditStatus {
  open
  partial
  settled
}

enum RequestStatus {
  pending
  reviewed
  ordered
}

// ─── USERS ────────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  name               String
  /// Login identifier (lower-cased). Nullable only for legacy rows created before the email/password switch.
  email              String?   @unique
  /// bcrypt(HMAC-SHA256(pepper, password))
  passwordHash       String?
  mustChangePassword Boolean   @default(false)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  role               Role      @default(staff)
  isActive           Boolean   @default(true)
  portalAccess       Portal[]
  /// Shape: { magazin: { pos: true, ... }, costumes: { rentals: true, ... } }
  modulePermissions  Json?
  preferredLanguage  Language  @default(ar)
  preferredTheme     Theme     @default(light)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sales                  Sale[]
  costumeSales           CostumeSale[]
  rentals                Rental[]            @relation("CreatedByUser")
  caisseSessions         CaisseSession[]
  closedSessions         CaisseSession[]     @relation("SessionClosedBy")
  manualEntries          CaisseManualEntry[]
  creditPayments         CreditPayment[]
  activityLogs           ActivityLog[]
  productRequests        ProductRequest[]
  rentalPayments         RentalPayment[]
  expenses               Expense[]
  authorizedSaleItems    SaleItem[]          @relation("SaleItemAuthorizer")
  authorizedCostumeItems CostumeSaleItem[]   @relation("CostumeSaleItemAuthorizer")
}

// ─── LOOKUP SYSTEM ────────────────────────────────────

model LookupCategory {
  id          String        @id @default(cuid())
  slug        String        @unique
  name_fr     String
  name_ar     String
  description String?
  createdAt   DateTime      @default(now())

  values      LookupValue[]
}

model LookupValue {
  id         String         @id @default(cuid())
  categoryId String
  category   LookupCategory @relation(fields: [categoryId], references: [id])
  label_fr   String
  label_ar   String
  order      Int            @default(0)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  expenses          Expense[]
  costumeTypes      CostumeItem[]    @relation("CostumeType")
  costumeSizes      CostumeItem[]    @relation("CostumeSize")
  costumePantsSizes CostumeItem[]    @relation("CostumePants")
  costumeShirtSizes CostumeItem[]    @relation("CostumeShirt")
  costumeShoeSizes  CostumeItem[]    @relation("CostumeShoe")
  products          Product[]        @relation("ProductCategory")
  variantSizes      ProductVariant[] @relation("VariantSize")
  variantColors     ProductVariant[] @relation("VariantColor")
}

// ─── SYSTEM SETTINGS / COUNTERS ──────────────────────

model SystemSettings {
  id                    String   @id @default(cuid())
  maintenanceMode       Boolean  @default(false)
  maintenanceMessage_fr String?
  maintenanceMessage_ar String?
  defaultStaffPermissions Json
  updatedAt             DateTime @updatedAt
}

/// Atomic sequence generator (kit references, item SKUs). Incremented with an upsert.
model Counter {
  key   String @id
  value Int    @default(0)
}

// ─── CLIENTS ─────────────────────────────────────────

model Client {
  id           String              @id @default(cuid())
  name         String
  phone        String              @unique
  address      String?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  rentals      Rental[]
  credits      Credit[]
}

// ─── MAGAZIN — PRODUCTS ──────────────────────────────

model Product {
  id              String           @id @default(cuid())
  name_fr         String
  name_ar         String
  categoryId      String
  category        LookupValue      @relation("ProductCategory", fields: [categoryId], references: [id])
  buyingPrice     Decimal          @db.Decimal(10, 2)
  sellingPrice    Decimal          @db.Decimal(10, 2)
  minSellingPrice Decimal          @db.Decimal(10, 2)
  images          String[]
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  variants        ProductVariant[]
}

model ProductVariant {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  sizeId    String?
  size      LookupValue? @relation("VariantSize", fields: [sizeId], references: [id])
  colorId   String?
  color     LookupValue? @relation("VariantColor", fields: [colorId], references: [id])
  stock     Int          @default(0)
  updatedAt DateTime     @updatedAt

  saleItems SaleItem[]
}

// ─── MAGAZIN — SALES ─────────────────────────────────

model Sale {
  id              String        @id @default(cuid())
  /// Client-generated idempotency key: a retried request returns the original sale.
  requestId       String?       @unique
  cashierId       String
  cashier         User          @relation(fields: [cashierId], references: [id])
  caisseSessionId String
  caisseSession   CaisseSession @relation(fields: [caisseSessionId], references: [id])
  totalAmount     Decimal       @db.Decimal(10, 2)
  amountPaid      Decimal       @db.Decimal(10, 2)
  paymentMethod   PaymentMethod
  isCredit        Boolean       @default(false)
  createdAt       DateTime      @default(now())

  items           SaleItem[]
  credit          Credit?

  @@index([createdAt])
  @@index([caisseSessionId])
}

model SaleItem {
  id             String         @id @default(cuid())
  saleId         String
  sale           Sale           @relation(fields: [saleId], references: [id])
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  quantity       Int
  unitPrice      Decimal        @db.Decimal(10, 2)
  wasBelowMin    Boolean        @default(false)
  authorizedById String?
  authorizedBy   User?          @relation("SaleItemAuthorizer", fields: [authorizedById], references: [id])
}

// ─── CAISSE ───────────────────────────────────────────

/// A partial unique index (see migration 20261005000000) guarantees ONE open session per portal:
///   CREATE UNIQUE INDEX "CaisseSession_one_open_per_portal" ON "CaisseSession"("portal") WHERE "closedAt" IS NULL;
model CaisseSession {
  id             String              @id @default(cuid())
  portal         Portal
  openedById     String
  openedBy       User                @relation(fields: [openedById], references: [id])
  closedById     String?
  closedBy       User?               @relation("SessionClosedBy", fields: [closedById], references: [id])
  openingAmount  Decimal             @db.Decimal(10, 2)
  closingAmount  Decimal?            @db.Decimal(10, 2)
  expectedAmount Decimal?            @db.Decimal(10, 2)
  openedAt       DateTime            @default(now())
  closedAt       DateTime?

  sales          Sale[]
  costumeSales   CostumeSale[]
  rentalPayments RentalPayment[]
  creditPayments CreditPayment[]
  manualEntries  CaisseManualEntry[]

  @@index([portal, closedAt])
  @@index([openedAt])
}

model CaisseManualEntry {
  id           String        @id @default(cuid())
  sessionId    String
  session      CaisseSession @relation(fields: [sessionId], references: [id])
  amount       Decimal       @db.Decimal(10, 2)
  reason       String
  recordedById String
  recordedBy   User          @relation(fields: [recordedById], references: [id])
  createdAt    DateTime      @default(now())
}

// ─── CREDITS ─────────────────────────────────────────

model Credit {
  id          String          @id @default(cuid())
  clientId    String?
  client      Client?         @relation(fields: [clientId], references: [id])
  clientName  String
  clientPhone String?
  saleId      String?         @unique
  sale        Sale?           @relation(fields: [saleId], references: [id])
  totalAmount Decimal         @db.Decimal(10, 2)
  amountPaid  Decimal         @db.Decimal(10, 2)
  balance     Decimal         @db.Decimal(10, 2)
  status      CreditStatus    @default(open)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  payments    CreditPayment[]

  @@index([status])
}

model CreditPayment {
  id              String         @id @default(cuid())
  creditId        String
  credit          Credit         @relation(fields: [creditId], references: [id])
  /// The magazin caisse session open when the payment was received (cash flow reconciliation).
  caisseSessionId String?
  caisseSession   CaisseSession? @relation(fields: [caisseSessionId], references: [id])
  amount          Decimal        @db.Decimal(10, 2)
  method          PaymentMethod
  recordedById    String
  recordedBy      User           @relation(fields: [recordedById], references: [id])
  createdAt       DateTime       @default(now())

  @@index([createdAt])
}

model ProductRequest {
  id            String        @id @default(cuid())
  productName   String
  categoryId    String?
  requestedById String
  requestedBy   User          @relation(fields: [requestedById], references: [id])
  requestCount  Int           @default(1)
  notes         String?
  status        RequestStatus @default(pending)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ─── COSTUMES ────────────────────────────────────────

/// Field meaning for RENTAL items (legacy column names kept to avoid a data migration):
///   sizeId      = suit size       colorId     = PANTS size (not a colour)
///   shirtSizeId = shirt size      shoeSizeId  = shoe size
model CostumeItem {
  id              String            @id @default(cuid())
  /// Human-readable unique code, e.g. "ART-0042" (generated from the `costume_item` counter).
  sku             String?           @unique
  name_fr         String
  name_ar         String
  typeId          String
  costumeType     LookupValue       @relation("CostumeType", fields: [typeId], references: [id])
  sizeId          String?
  size            LookupValue?      @relation("CostumeSize", fields: [sizeId], references: [id])
  colorId         String?
  pantsSize       LookupValue?      @relation("CostumePants", fields: [colorId], references: [id])
  shirtSizeId     String?
  shirtSize       LookupValue?      @relation("CostumeShirt", fields: [shirtSizeId], references: [id])
  shoeSizeId      String?
  shoeSize        LookupValue?      @relation("CostumeShoe", fields: [shoeSizeId], references: [id])
  stock           Int               @default(1)
  images          String[]
  buyingPrice     Decimal           @db.Decimal(10, 2)
  sellingPrice    Decimal           @db.Decimal(10, 2)
  minSellingPrice Decimal           @db.Decimal(10, 2)
  segment         ItemSegment       @default(sale)
  refGuidePrice   Decimal?          @db.Decimal(10, 2)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  rentalKitItems   RentalKitItem[]
  costumeSaleItems CostumeSaleItem[]
}

// ─── RENTALS ─────────────────────────────────────────

model Rental {
  id                  String              @id @default(cuid())
  requestId           String?             @unique
  clientId            String
  client              Client              @relation(fields: [clientId], references: [id])
  status              RentalStatus        @default(booked)
  bookingDate         DateTime            @default(now())
  eventDate           DateTime?
  scheduledPickupDate DateTime
  scheduledReturnDate DateTime
  actualPickupDate    DateTime?
  actualReturnDate    DateTime?
  totalAmount         Decimal             @db.Decimal(10, 2)
  /// Rental money received (advance + balance payments). Deposits are NOT included.
  amountPaid          Decimal             @db.Decimal(10, 2) @default(0)
  balance             Decimal             @db.Decimal(10, 2)
  guaranteeType       GuaranteeType
  guaranteeAmount     Decimal?            @db.Decimal(10, 2)
  guaranteePhotoUrl   String?
  depositApplied      Boolean             @default(false)
  depositReturned     Boolean             @default(false)
  notes               String?
  cancelledAt         DateTime?
  cancelReason        String?
  createdById         String
  createdBy           User                @relation("CreatedByUser", fields: [createdById], references: [id])
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  kit                 RentalKit?
  payments            RentalPayment[]

  @@index([status])
  @@index([scheduledReturnDate])
}

model RentalKit {
  id        String          @id @default(cuid())
  rentalId  String          @unique
  rental    Rental          @relation(fields: [rentalId], references: [id])
  reference String          @unique
  notes     String?
  createdAt DateTime        @default(now())

  items     RentalKitItem[]
}

model RentalKitItem {
  id            String      @id @default(cuid())
  kitId         String
  kit           RentalKit   @relation(fields: [kitId], references: [id])
  costumeItemId String
  costumeItem   CostumeItem @relation(fields: [costumeItemId], references: [id])
  quantity      Int         @default(1)
  returned      Boolean     @default(false)
}

model RentalPayment {
  id              String          @id @default(cuid())
  rentalId        String
  rental          Rental          @relation(fields: [rentalId], references: [id])
  caisseSessionId String
  caisseSession   CaisseSession   @relation(fields: [caisseSessionId], references: [id])
  amount          Decimal         @db.Decimal(10, 2)
  method          PaymentMethod
  type            TransactionType
  recordedById    String
  recordedBy      User            @relation(fields: [recordedById], references: [id])
  createdAt       DateTime        @default(now())

  @@index([createdAt])
  @@index([rentalId])
}

// ─── COSTUME DIRECT SALES ────────────────────────────

model CostumeSale {
  id              String            @id @default(cuid())
  requestId       String?           @unique
  cashierId       String
  cashier         User              @relation(fields: [cashierId], references: [id])
  caisseSessionId String
  caisseSession   CaisseSession     @relation(fields: [caisseSessionId], references: [id])
  totalAmount     Decimal           @db.Decimal(10, 2)
  paymentMethod   PaymentMethod
  createdAt       DateTime          @default(now())

  items           CostumeSaleItem[]

  @@index([createdAt])
  @@index([caisseSessionId])
}

model CostumeSaleItem {
  id             String      @id @default(cuid())
  saleId         String
  sale           CostumeSale @relation(fields: [saleId], references: [id])
  costumeItemId  String
  costumeItem    CostumeItem @relation(fields: [costumeItemId], references: [id])
  quantity       Int
  unitPrice      Decimal     @db.Decimal(10, 2)
  wasBelowMin    Boolean     @default(false)
  authorizedById String?
  authorizedBy   User?       @relation("CostumeSaleItemAuthorizer", fields: [authorizedById], references: [id])
}

// ─── EXPENSES ────────────────────────────────────────

model Expense {
  id           String   @id @default(cuid())
  portal       Portal
  categoryId   String
  category     LookupValue @relation(fields: [categoryId], references: [id])
  amount       Decimal  @db.Decimal(10, 2)
  description  String
  date         DateTime @default(now())
  recordedById String
  recordedBy   User     @relation(fields: [recordedById], references: [id])
  receiptUrl   String?
  createdAt    DateTime @default(now())

  @@index([date])
}

// ─── NOTIFICATIONS / ACTIVITY LOGS ───────────────────

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String
  type      String
  portal    String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  portal     Portal
  entityType String
  entityId   String
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  diff       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([portal, createdAt])
  @@index([entityType])
}
